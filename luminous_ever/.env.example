# Copy this file to .env and fill in real values. Never commit .env itself.

DEBUG=False
SECRET_KEY=change-me-generate-a-new-one
ALLOWED_HOSTS=luminousever.com,www.luminousever.com

SITE_NAME=Luminous Ever
SITE_DOMAIN=luminousever.com

# Postgres in production, e.g:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

TIME_ZONE=Asia/Kolkata

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@luminousever.com
LEAD_NOTIFICATION_EMAIL=hello@luminousever.com

# Production-only (config/settings/production.py)
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://luminousever.com,https://www.luminousever.com

# Change this from the default before going live — keeps /admin/ off a
# well-known, guessable path. Include the trailing slash.
ADMIN_URL_PATH=backstage-change-me/

BUSINESS_WHATSAPP_NUMBER=91XXXXXXXXXX
BUSINESS_PHONE_NUMBER=+91XXXXXXXXXX
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
META_PIXEL_ID=
